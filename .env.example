# Optional: Alpha Vantage key for extra market data (leave empty to use Yahoo Finance only)
ALPHA_VANTAGE_API_KEY=

# Optional: require X-API-Key on every API call (web proxy forwards it server-side). Empty = auth disabled (localhost use only).
API_KEY=

# Comma-separated browser origins allowed by CORS (never "*")
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max CSV upload size in bytes
MAX_UPLOAD_BYTES=2097152
